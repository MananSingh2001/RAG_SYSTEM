# Copy to .env and fill in. Never commit .env.
# Supabase — use the SERVICE ROLE key (server-side only, bypasses RLS).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenRouter — used for embeddings (OpenAI-compatible). May require prepaid credit.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Groq — used for generation and the LLM-judge (OpenAI-compatible, free tier, no card).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional
PORT=8080
