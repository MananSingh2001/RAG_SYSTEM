# Copy to .env and fill in. Never commit .env.
# Supabase — use the SERVICE ROLE key (server-side only, bypasses RLS).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenRouter — used for embeddings (OpenAI-compatible). May require prepaid credit.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Groq — used for generation and the LLM-judge (OpenAI-compatible, free tier, no card).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Cohere — OPTIONAL cross-encoder reranker (free trial: no card, 1k calls/mo).
# If unset, retrieval falls back to plain vector order. Get a key at
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Langfuse — OPTIONAL request tracing (retrieve/rerank/generate spans per
# query). If either key is unset, tracing calls are no-ops (same behaviour).
# Get keys at https://cloud.langfuse.com (or self-hosted; set LANGFUSE_HOST).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OPTIONAL — USD price per 1M tokens for the Groq generation model, used only
# by `npm run eval:latency` to report cost/1k queries. Check current pricing
# at https://groq.com/pricing before setting these; if unset, cost is
# reported as null rather than guessed.
GROQ_PRICE_IN_PER_M=
GROQ_PRICE_OUT_PER_M=

# Optional
PORT=8080
